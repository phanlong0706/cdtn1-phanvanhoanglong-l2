Table customer {
  customer_id bigint [pk, increment]
  full_name varchar(120) [not null]
  phone varchar(10) [not null, unique]
  created_at timestamp [not null]
}
Table device {
  device_id bigint [pk, increment]
  customer_id bigint [not null, ref: > customer.customer_id]
  model_name varchar(100) [not null]
  serial_no varchar(50) [not null, unique]
  purchase_date date
  warranty_months smallint [not null, default: 12]
}
Table service_center {
  center_id bigint [pk, increment]
  center_name varchar(100) [not null, unique]
  city varchar(50) [not null]
}
Table issue_category {
  category_id int [pk, increment]
  category_code varchar(30) [not null, unique]
  category_name varchar(60) [not null, unique]
  default_priority varchar(10) [not null]
  is_active boolean [not null, default: true]
}
Table ticket {
  ticket_id bigint [pk, increment]
  ticket_code varchar(20) [not null, unique]
  customer_id bigint [not null, ref: > customer.customer_id]
  device_id bigint [not null, ref: > device.device_id]
  center_id bigint [not null, ref: > service_center.center_id]
  category_id int [not null, ref: > issue_category.category_id]
  issue_desc text [not null]
  priority varchar(10) [not null]
  status varchar(20) [not null, default: 'MOI']
  warranty_status varchar(20) [not null]
  received_at timestamp [not null]
  due_date timestamp [not null]
  indexes {
    received_at
    customer_id
    (center_id, status)
  }
}
Table ticket_status_log {
  log_id bigint [pk, increment]
  ticket_id bigint [not null, ref: > ticket.ticket_id]
  from_status varchar(20)
  to_status varchar(20) [not null]
  changed_at timestamp [not null]
  changed_by varchar(100) [not null]
  note varchar(255)
}